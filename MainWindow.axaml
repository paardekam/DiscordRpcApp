<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DiscordRpcApp.MainWindow"
        Title="Discord RPC Manager" Width="500" Height="420"
        CanResize="False">
    
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="8">
            <TextBlock Text="Discord Rich Presence Configurator" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

            <TextBlock Text="Discord Client ID:"/>
            <TextBox x:Name="TxtClientId"/>

            <TextBlock Text="Details (Status Text):"/>
            <TextBox x:Name="TxtDetails" Text="Coding a C# App"/>

            <TextBlock Text="Large Image (URL or Asset Key):"/>
            <TextBox x:Name="TxtLargeImage" Text="https://i.imgur.com/8N482pM.png"/>

            <TextBlock Text="Large Image Hover Text:"/>
            <TextBox x:Name="TxtLargeText" Text="Visual Mac App"/>

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,15,0,0">
                <Button x:Name="BtnUpdate" Content="Start / Update RPC" Width="215" Click="BtnUpdate_Click"/>
                <Button x:Name="BtnStop" Content="Disconnect" Width="215" Click="BtnStop_Click"/>
            </StackPanel>

            <TextBlock x:Name="LblStatus" Text="Status: Disconnected" Foreground="Red" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>