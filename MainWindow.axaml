<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DiscordRpcApp.MainWindow"
        Title="Discord RPC Manager" Width="460" Height="520"
        CanResize="False"
        Background="#1E1F22"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- Modern Dark TextBoxes -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#2B2D31"/>
            <Setter Property="Foreground" Value="#F2F3F5"/>
            <Setter Property="BorderBrush" Value="#1E1F22"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#5865F2"/>
            <Setter Property="Background" Value="#2B2D31"/>
        </Style>

        <!-- Primary Action Button (Discord Blurple) -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#5865F2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#4752C4"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Secondary Button (Dark Outlined) -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#2B2D31"/>
            <Setter Property="Foreground" Value="#DBDEE1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#35373C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,18">
            <TextBlock Text="Discord Rich Presence" FontSize="20" FontWeight="Bold" Foreground="#F2F3F5"/>
            <TextBlock Text="Configure and broadcast your custom activity status" FontSize="12" Foreground="#949BA4"/>
        </StackPanel>

        <!-- Input Card Panel -->
        <Border Grid.Row="1" Background="#2B2D31" CornerRadius="12" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">

                    <StackPanel Spacing="6">
                        <TextBlock Text="DISCORD CLIENT ID" FontSize="11" FontWeight="Bold" Foreground="#B5BAC1"/>
                        <TextBox x:Name="TxtClientId" PlaceholderText="e.g. 123456789012345678"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="STATUS DETAILS (LINE 1)" FontSize="11" FontWeight="Bold" Foreground="#B5BAC1"/>
                        <TextBox x:Name="TxtDetails" PlaceholderText="e.g. Working on a project"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="LARGE IMAGE URL OR ASSET KEY" FontSize="11" FontWeight="Bold" Foreground="#B5BAC1"/>
                        <TextBox x:Name="TxtLargeImage" PlaceholderText="https://i.imgur.com/example.png"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="LARGE IMAGE HOVER TEXT" FontSize="11" FontWeight="Bold" Foreground="#B5BAC1"/>
                        <TextBox x:Name="TxtLargeText" PlaceholderText="Hover text description"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer / Controls -->
        <StackPanel Grid.Row="2" Spacing="14" Margin="0,18,0,0">
            <Grid ColumnDefinitions="*,*">
                <Button x:Name="BtnUpdate" Grid.Column="0" Classes="primary" Content="Update Status" Margin="0,0,6,0" Click="BtnUpdate_Click"/>
                <Button x:Name="BtnStop" Grid.Column="1" Classes="secondary" Content="Disconnect" Margin="6,0,0,0" Click="BtnStop_Click"/>
            </Grid>

            <!-- Status Indicator Badge -->
            <Border x:Name="PnlStatus" Background="#2B2D31" CornerRadius="6" Padding="10,8">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Ellipse x:Name="DotStatus" Width="8" Height="8" Fill="#F23F43"/>
                    <TextBlock x:Name="LblStatus" Text="Disconnected" FontSize="12" FontWeight="Medium" Foreground="#DBDEE1"/>
                </StackPanel>
            </Border>
        </StackPanel>

    </Grid>
</Window>